# Example environment variables for the PaydMap frontend
#
# Copy this file to `.env` and replace the placeholder values with your
# own configuration.  The Expo app reads these values at runtime to
# configure API and Supabase access.

# Base URL for the backend API.  For development this typically points to
# your local machine running the Express server (ensure that your mobile
# device can reach your computer on this port).  In production you will
# replace this with your deployed API URL.
API_BASE_URL=http://localhost:4000

# Supabase project URL and anon key used by the frontend to directly
# query Supabase for read-only data.  These should match the values used
# by the backend.  Never commit your service role key here — use the anon
# key instead.
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key