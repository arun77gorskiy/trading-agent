# Example environment variables for the PaydMap backend
#
# Copy this file to `.env` and replace the placeholder values with your actual
# Supabase project details.  The backend uses these values to connect to
# Supabase and to determine which port to listen on.

SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

## The port the Express server will run on. Defaults to 4000 if not set.
PORT=4000