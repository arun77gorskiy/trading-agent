{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-native",
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": false,
    "types": ["jest", "react-native", "@types/jest"],
    "baseUrl": "./",
    "paths": {
      "@/components/*": ["components/*"],
      "@/theme": ["theme.ts"],
      "@/lib/*": ["lib/*"]
    }
  },
  "include": ["app/**/*", "components/**/*", "lib/**/*", "theme.ts"]
}