{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-native",
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "baseUrl": "./",
    "paths": {
      "@/components/*": ["components/*"],
      "@/theme": ["theme.ts"],
      "@/lib/*": ["lib/*"]
    }
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "lib/**/*",
    "theme.ts",
    "types.d.ts"
  ]
}
